# Dev: leave unset to use Vite proxy (same origin /api → http://127.0.0.1:8765)
# VITE_API_BASE=http://127.0.0.1:8000/api
#
# Vercel / Netlify production build: set in the host dashboard (build-time) to your API origin, e.g.:
# VITE_API_BASE=https://helix-demo.onrender.com/api
#
# Optional: audit line in copied / client-exported Markdown
# VITE_HELIX_EXPORT_MODEL=o3
# VITE_HELIX_EXPORT_USER=demo@acme.com