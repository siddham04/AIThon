# --- Azure OpenAI (leave blank for deterministic demo/mock mode) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=o3
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Alternate names supported by Helix:
# AZURE_OAI_ENDPOINT=
# AZURE_OAI_KEY=
# PLANNING_MODEL=o3

# --- Server ---
HELIX_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
HELIX_DEBUG=true

# Demo UI login (used by API bootstrap + scripts/seed.py)
HELIX_DEMO_EMAIL=demo@demo.com
HELIX_DEMO_PASSWORD=demo123

# Where JSON snapshots are written after analyze / PATCH / append-notes
HELIX_DATA_DIR=.helix-data

# Optional: require X-Helix-Key or Authorization: Bearer <key> on all /api/* routes except /api/health
HELIX_API_KEY=
# When HELIX_API_KEY is set, put the same value in helix-frontend `.env.local` as VITE_HELIX_API_KEY.

# --- Anthropic (optional; ambiguity / tests / estimator prefer Claude when set) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: label in GET /api/export/markdown audit footer (defaults to AZURE_OPENAI_DEPLOYMENT)
# HELIX_EXPORT_MODEL_LABEL=o3

# --- Phase 2 (SQLAlchemy, JWT, Redis/Celery, Mongo) ---

# --- JIRA REST export (Phase 5) ---
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_TOKEN=               # API token (Cloud)
# JIRA_PROJECT_KEY=HELIX
# JIRA_EPIC_LINK_FIELD=     # Classic only, e.g. customfield_10014

# Optional: POST Jira-import CSV here when calling POST /api/projects/{id}/integrations/jira-stub
HELIX_JIRA_WEBHOOK_URL=
