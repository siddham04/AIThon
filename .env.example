# Copy to `.env` in this directory before `docker compose up`:
#   cp .env.example .env
#
# --- Required for AI generation / streaming ---
ANTHROPIC_API_KEY=

# --- Auth ---
JWT_SECRET=change-me-in-production-use-openssl-rand

# --- URLs (defaults below match docker-compose.yml service names) ---
# Postgres (SQLAlchemy): used when running API outside Compose or overriding Compose env
POSTGRES_URL=postgresql://helix:helix@localhost:5432/helix

# Redis (Celery / cache / progress)
REDIS_URL=redis://localhost:6379/0

# MongoDB (requirement snapshots / version history)
MONGO_URL=mongodb://localhost:27017/helix

# --- JIRA REST export (optional; leave blank for CSV/webhook-only export) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=

# --- Optional ---
HELIX_USE_CELERY=0
HELIX_DEBUG=false

# Inside Docker Compose, DATABASE_URL, REDIS_URL, and MONGO_URL are injected for the
# backend service; set MONGO_URL above only if you need host-local overrides.
