# syntax=docker/dockerfile:1
# Single public URL: React SPA + FastAPI on one process (same-origin /api).
# Used for free-tier PaaS (e.g. Render). Build context = repository root.

FROM node:20-bookworm-slim AS frontend-build
WORKDIR /app
COPY helix-frontend/package.json helix-frontend/package-lock.json helix-frontend/.npmrc ./
RUN npm ci
COPY helix-frontend/ ./
# Omit VITE_API_BASE so the browser uses same-origin `/api` (see src/api/client.js).
RUN npm run build

FROM python:3.11-slim AS pybuilder
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl build-essential \
    && rm -rf /var/lib/apt/lists/*

# Allow callers to swap in `requirements.txt` (full ML stack — needs
# Render Starter or larger) by passing `--build-arg REQUIREMENTS_FILE=requirements.txt`.
# The default `requirements-render.txt` is the slim install that runs
# safely on Render Free tier (512 MB RAM, ~25 min build budget).
# See helix-backend/requirements-render.txt for the full reasoning
# and the list of intentionally-omitted heavy ML deps.
ARG REQUIREMENTS_FILE=requirements-render.txt
COPY helix-backend/requirements.txt helix-backend/requirements-render.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --no-cache-dir --prefer-binary -r "${REQUIREMENTS_FILE}"
# Only download the spaCy model if spacy is actually installed
# (it is in `requirements.txt` but NOT in `requirements-render.txt`).
RUN --mount=type=cache,target=/root/.cache/pip \
    if python -c "import spacy" 2>/dev/null; then \
        python -m spacy download en_core_web_sm ; \
    else \
        echo "[helix] spaCy not installed in this build — skipping en_core_web_sm download (nlp_service falls back to heuristic ambiguity detection)" ; \
    fi
COPY helix-backend/ /app/
RUN chmod +x /app/docker-entrypoint.sh

FROM python:3.11-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=pybuilder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=pybuilder /usr/local/bin /usr/local/bin
COPY --from=pybuilder /app /app
COPY --from=frontend-build /app/dist /app/static
COPY deploy/all-in-one/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PYTHONPATH=/app
ENV HELIX_SERVE_SPA=1
ENV HELIX_STATIC_DIR=/app/static
ENV HELIX_DEBUG=0
ENV HELIX_DEMO_FAST=1
ENV HELIX_HACKATHON_AUTH=1
# SQLite in container (ephemeral on free hosts unless you attach a disk).
ENV DATABASE_URL=sqlite:////app/data/helix.db

RUN mkdir -p /app/data

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
